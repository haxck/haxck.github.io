---
const today = new Date();
---

<footer class="w-full mt-20 relative">
  <!-- Gradient top border -->
  <div class="h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent" />

  <div class="container px-4 mx-auto py-10">
    <div class="max-w-screen-lg mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
      <nav aria-label="Footer links">
        <ul class="flex flex-wrap items-center gap-1">
          <li>
            <a href="/friends" class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-500 dark:hover:text-primary-400 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800/50 transition-all duration-300">友链</a>
          </li>
          <li>
            <a href="https://status.haxck.com/status/haxck" target="_blank" class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-500 dark:hover:text-primary-400 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800/50 transition-all duration-300">状态</a>
          </li>
          <li>
            <a href="/changelog" class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-500 dark:hover:text-primary-400 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800/50 transition-all duration-300">更新</a>
          </li>
          <li>
            <a href="/feed.xml" target="_blank" class="px-3 py-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-primary-500 dark:hover:text-primary-400 rounded-md hover:bg-gray-100 dark:hover:bg-gray-800/50 transition-all duration-300">RSS</a>
          </li>
        </ul>
      </nav>

      <div class="flex items-center gap-2 text-sm text-gray-400 dark:text-gray-500">
        <span>&copy; 2018 - {today.getFullYear()}</span>
        <span class="w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-600" />
        <a href="/" class="font-semibold bg-gradient-to-r from-primary-500 to-secondary-500 bg-clip-text text-transparent hover:from-secondary-500 hover:to-primary-500 transition-all duration-500">
          haxck.com
        </a>
      </div>
    </div>
  </div>
</footer>
