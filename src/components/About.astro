---
import { getCollection } from "astro:content";

interface Props {
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;

const posts = await getCollection("blog");

// Build tag cloud with counts
const tagMap: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagMap[tag] = (tagMap[tag] || 0) + 1;
  });
});
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
---

<div class="h-full animate-fade-in">
  <div class="text-center lg:text-right">
    <a href="/" class="inline-block">
      <h1
        class="font-bold text-4xl title tracking-[3px] dark:text-gray-200 bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent animate-slide-up"
      >
        Haxck
      </h1>
      <p class="text-gray-500 dark:text-gray-400 mt-2 font-medium animate-slide-up">
        Creator & Developer
      </p>
    </a>
  </div>

  <div class="py-6 sticky top-6 space-y-6">
    <slot />

    {showSidebar && (
      <div class="max-lg:hidden text-right space-y-6">
        {/* Personal intro */}
        <div>
          <h3 class="text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">
            关于
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            一个喜欢折腾技术的开发者，记录学习与思考。
          </p>
        </div>

        {/* Tag cloud */}
        <div>
          <h3 class="text-sm font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">
            标签
          </h3>
          <div class="flex flex-wrap justify-end gap-2">
            {
              tags.map(([tag, count]) => (
                <a
                  href={`/tags/${tag}/`}
                  class="inline-block px-2.5 py-1 text-xs rounded-full bg-white/60 dark:bg-gray-700/60 text-gray-600 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200 border border-gray-200/50 dark:border-gray-600/50"
                >
                  {tag}
                  <span class="ml-1 text-gray-400 dark:text-gray-500">{count}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  @font-face {
    font-family: "得意黑";
    font-weight: 400;
    src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
    font-display: swap;
  }
  .title {
    font-family: "得意黑";
  }
</style>
