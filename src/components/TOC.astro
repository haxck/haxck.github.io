---
import type { TocItem } from "../utils/generateToc";

interface Props {
	toc: TocItem[];
	depth?: number;
	isMobile?: boolean;
}

const { toc, isMobile = false, depth = 0 } = Astro.props;
---

{
	toc.length>1 ?
	(
		<div class="table-of-contents">
			<ul>
				{toc.slice(depth === 0 ? 1 : 0).map((heading) => (
					<li>
						<a href={"#" + heading.slug}>
							{heading.text}
						</a>
						{heading.children.length > 0 && (
							<Astro.self
								toc={heading.children}
								depth={depth + 1}
								isMobile={isMobile}
							/>
						)}
					</li>
				))}
			</ul>
		</div>
	)
	: ""
}

<script>
	function setupToc() {
		const tocLinks = Array.from(document.querySelectorAll('.table-of-contents a'));
		const headings = tocLinks.map(link => {
			const id = link.getAttribute('href')?.substring(1);
			return id ? document.getElementById(id) : null;
		}).filter(Boolean);

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					const id = entry.target.getAttribute('id');
					const link = document.querySelector(`.table-of-contents a[href="#${id}"]`);
					if (entry.isIntersecting) {
						tocLinks.forEach(l => l.removeAttribute('aria-current'));
						if (link) link.setAttribute('aria-current', 'true');
					}
				});
			},
			{ rootMargin: '0px 0px -80% 0px', threshold: 0.1 }
		);

		headings.forEach(h => observer.observe(h));

		tocLinks.forEach(link => {
			link.addEventListener('click', (e) => {
				e.preventDefault();
				const id = link.getAttribute('href')?.substring(1);
				const el = id ? document.getElementById(id) : null;
				if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
			});
		});
	}

	setupToc();
	document.addEventListener('astro:page-load', setupToc);
</script>

<style define:vars={{ depth }}>
	.table-of-contents {
		padding: 0;
		margin: 0;
		overflow-y: auto;
		max-height: calc(100vh - 10rem);
	}

	.table-of-contents::-webkit-scrollbar {
		width: 3px;
	}

	.table-of-contents::-webkit-scrollbar-track {
		background: transparent;
	}

	.table-of-contents::-webkit-scrollbar-thumb {
		background: rgba(0, 0, 0, 0.08);
		border-radius: 999px;
	}

	ul {
		font-size: 0.8125rem;
		padding: 0;
		list-style: none;
		margin: 0;
		border-left: 1px solid rgba(0, 0, 0, 0.06);
	}

	:global(.dark) ul {
		border-left-color: rgba(255, 255, 255, 0.08);
	}

	li {
		margin-bottom: 0;
	}

	a {
		--pad-inline: 0.75rem;
		display: block;
		border-radius: 0 0.25rem 0.25rem 0;
		padding-block: 0.3rem;
		padding-inline: calc(0.75rem * var(--depth) + var(--pad-inline)) var(--pad-inline);
		line-height: 1.5;
		transition: all 0.15s ease;
		text-decoration: none;
		color: #64748b;
		border-left: 2px solid transparent;
		margin-left: -1px;
	}

	:global(.dark) a {
		color: #94a3b8;
	}

	a:hover {
		color: #0891b2;
	}

	:global(.dark) a:hover {
		color: #22d3ee;
	}

	a[aria-current="true"] {
		color: #0891b2;
		font-weight: 500;
		border-left-color: #0891b2;
	}

	:global(.dark) a[aria-current="true"] {
		color: #22d3ee;
		border-left-color: #22d3ee;
	}
</style>