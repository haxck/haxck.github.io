---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  // Imported image from import.meta.glob — passed directly to <Image src={img} />
  img: ImageMetadata;
  alt: string;
  location?: string;
  date?: string;
  tags?: string[];
  index: number;
}

const { img, alt, location, date, tags, index } = Astro.props;

// Derive display dimensions from imported metadata for aspect-ratio
const meta = img as ImageMetadata;
const aspectRatio = meta.width && meta.height ? `${meta.width} / ${meta.height}` : "3 / 2";
const tagStr = tags?.join(",") || "";
---

<div class="photo-item mb-4 break-inside-avoid" data-tags={tagStr} data-index={index}>
  <figure class="group relative m-0 overflow-hidden rounded-lg shadow-sm hover:shadow-md transition-shadow cursor-zoom-in">
    <Image
      src={img}
      alt={alt}
      format="webp"
      loading="lazy"
      decoding="async"
      style={`aspect-ratio: ${aspectRatio}; object-fit: cover; width: 100%;`}
      class="transition-transform duration-300 group-hover:scale-105"
      data-index={index}
    />
    <figcaption class="absolute inset-0 flex flex-col justify-end bg-linear-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none p-3 text-white">
      <p class="text-sm leading-snug m-0">{alt}</p>
      {(location || date) && (
        <p class="text-xs text-white/70 mt-1 m-0">
          {location && <span>{location}</span>}
          {location && date && <span> · </span>}
          {date && <span>{date}</span>}
        </p>
      )}
    </figcaption>
  </figure>
</div>
