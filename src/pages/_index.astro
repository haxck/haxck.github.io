---
import { getCollection } from "astro:content";
import IndexPage from "../layouts/IndexPage.astro";
import About from "../components/About.astro";
import { Image } from "astro:assets";
import nmQR from "../assets/images/nmQR.png";
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((_, index) => index < 5);
---

<IndexPage title="首页">
  <About slot="left" />
  <div slot="right">
    <div class="">
      <h1 class="font-bold mb-3 title text-2xl">Posts</h1>
      <ul>
        {
          posts.map((post) => (
            <li class="max-sm:text-base max-sm:px-2 lg:text-lg px-4 py-2 hover:text-gray-200 rounded-lg">
              <a class="flex" href={`/posts/${post.slug}/`}>
                {post.data.title}
                <span class="border-t-2 border-dashed flex-1 m-3 max-sm:m-2.5" />
                <span>{post.data.pubDate.toLocaleDateString()}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</IndexPage>
<style>
  @font-face {
    font-family: "得意黑";
    font-weight: 400;
    src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
    font-display: swap;
  }
  .title {
    font-family: "得意黑";
  }
</style>
