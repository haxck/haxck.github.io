---
import { getCollection } from "astro:content";
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";

const quotes = (await getCollection("quotes"))[0];
---

<IndexPage 
  title="收集"
  description="收集的语录、灵感和有趣的内容"
  keywords={['收集', '语录', '灵感', '摘录']}
>
  <About slot="left" />

  <section class="px-2" slot="right">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-1">收集</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500">
        值得细细品味的话
      </p>
    </div>

    <div class="space-y-6">
      {quotes.data.map((quote) => (
        <blockquote class="relative pl-5 border-l-2 border-gray-200 dark:border-gray-700">
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
            {quote.text}
          </p>
          {(quote.source || quote.author) && (
            <footer class="mt-2 text-sm text-gray-400 dark:text-gray-500">
              {quote.url ? (
                <a
                  href={quote.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                >
                  {quote.source && <span>{quote.source}</span>}
                  {quote.source && quote.author && <span> · </span>}
                  {quote.author && <span>{quote.author}</span>}
                </a>
              ) : (
                <>
                  {quote.source && <span>{quote.source}</span>}
                  {quote.source && quote.author && <span> · </span>}
                  {quote.author && <span>{quote.author}</span>}
                </>
              )}
            </footer>
          )}
        </blockquote>
      ))}
    </div>
  </section>
</IndexPage>
