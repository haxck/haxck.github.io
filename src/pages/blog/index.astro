---
import { getCollection } from "astro:content";
import IndexPage from "../..//layouts/IndexPage.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const blogsByYear: Record<string, typeof blogs> = {};
const blogs = await getCollection("blog");

blogs
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((blog) => {
    const year = new Date(blog.data.pubDate).getFullYear().toString();
    if (!blogsByYear[year]) {
      blogsByYear[year] = [];
    }
    blogsByYear[year].push(blog);
  });
---

<IndexPage title="博客" sidebar={false}>

  <section class="px-2" slot="right">
    {
      Object.keys(blogsByYear)
        .sort((a, b) => Number(b) - Number(a))
        .map((year) => (
          <div class="mb-10">
            <h2 class="text-2xl font-bold mb-4 flex items-baseline gap-3">
              <span class="bg-gradient-to-r from-primary-500 to-secondary-500 bg-clip-text text-transparent">{year}</span>
              <span class="text-sm font-normal text-gray-400 dark:text-gray-500">
                {blogsByYear[year].length} 篇
              </span>
            </h2>
            <ul class="flex flex-col gap-2">
              {blogsByYear[year].map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.id}/`}
                      class="group flex items-center gap-4 p-4 rounded-xl bg-white/60 dark:bg-gray-800/40 border border-gray-100/80 dark:border-gray-700/40 transition-colors duration-200"
                    >
                      <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between gap-3">
                          <h3 class="font-medium text-gray-800 dark:text-gray-100 line-clamp-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                            {post.data.title}
                          </h3>
                          <time class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap tabular-nums">
                            <FormattedDate date={post.data.pubDate} />
                          </time>
                        </div>
                        {post.data.tags && post.data.tags.length > 0 && (
                          <div class="flex flex-wrap gap-1.5 mt-2">
                            {post.data.tags.slice(0, 3).map((tag: string) => (
                              <span class="text-xs text-gray-400 dark:text-gray-500 bg-gray-100/80 dark:bg-gray-700/50 px-2 py-0.5 rounded-md">
                                {tag}
                              </span>
                            ))}
                          </div>
                        )}
                      </div>
                    </a>
                  </li>
              ))}
            </ul>
          </div>
        ))
    }
  </section>
</IndexPage>
