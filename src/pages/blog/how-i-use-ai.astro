---
import { getCollection } from "astro:content";
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";
const entries = await getCollection("useai");
---

<IndexPage title="我如何用 AI">
    <About slot="left" />
    <div slot="right">
        <div class="mb-8">
            <h1 class="text-3xl font-bold mb-1">我如何用 AI</h1>
            <p class="text-sm text-gray-400 dark:text-gray-500">
                记录日常工作生活中使用 AI 提高效率的方式
            </p>
        </div>

        <ul class="space-y-3">
            {
                entries[0].data.tools.map((entry) => (
                    <li class="p-5 bg-gray-50 dark:bg-gray-800/50 rounded-xl border border-gray-100 dark:border-gray-700/50">
                        <h2 class="font-semibold text-gray-800 dark:text-gray-100 mb-2">
                            {entry.title}
                        </h2>
                        <div class="flex flex-wrap gap-1.5 mb-3">
                            {entry.tools.map((e) => (
                                <span class="px-2 py-0.5 text-xs text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 rounded">
                                    {e}
                                </span>
                            ))}
                        </div>
                        <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                            {entry.description}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</IndexPage>
