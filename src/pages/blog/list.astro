---
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";

interface Goal {
  text: string;
  sub: string;
  done: boolean;
  note?: string;
}

const goals: Goal[] = [
  { text: "Write blog", sub: "写博客", done: true },
  { text: "Driver's license", sub: "考取驾照", done: true },
  { text: "Have business", sub: "做生意", done: false },
  { text: "Go to a music festival", sub: "去一次音乐节", done: true, note: "2024-12-29" },
  { text: "Learn to ski", sub: "滑雪", done: false },
  { text: "Make a game", sub: "做游戏", done: false },
  { text: "Write a book", sub: "写书", done: false },
  { text: "Make a Wechat Sticker", sub: "做微信表情包", done: false },
];
---

<IndexPage title="清单">
  <About slot="left" />

  <section class="px-2" slot="right">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-1">清单</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500">
        去体验，去思考，充实人生
      </p>
    </div>

    <ul class="space-y-2">
      {goals.map((goal) => (
        <li class:list={[
          "flex items-center gap-4 px-4 py-3.5 rounded-xl transition-colors duration-200",
          goal.done
            ? "bg-gray-50 dark:bg-gray-800/50"
            : "bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700",
        ]}>
          <span class:list={[
            "flex-shrink-0 w-5 h-5 rounded-full border-2 flex items-center justify-center",
            goal.done
              ? "border-gray-300 dark:border-gray-600 bg-gray-300 dark:bg-gray-600"
              : "border-gray-300 dark:border-gray-600",
          ]}>
            {goal.done && (
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </span>

          <div class="flex-1 min-w-0">
            <span class:list={[
              "block font-medium",
              goal.done
                ? "text-gray-400 dark:text-gray-500 line-through"
                : "text-gray-800 dark:text-gray-100",
            ]}>
              {goal.text}
            </span>
            <span class:list={[
              "block text-sm mt-0.5",
              goal.done
                ? "text-gray-300 dark:text-gray-600 line-through"
                : "text-gray-400 dark:text-gray-500",
            ]}>
              {goal.sub}
            </span>
          </div>

          {goal.note && (
            <span class="text-xs text-gray-300 dark:text-gray-600 shrink-0 tabular-nums">
              {goal.note}
            </span>
          )}
        </li>
      ))}
    </ul>
  </section>
</IndexPage>
