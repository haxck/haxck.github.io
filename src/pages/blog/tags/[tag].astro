---
import { getCollection } from "astro:content";
import IndexPage from "../../../layouts/IndexPage.astro";
import About from "../../../components/About.astro";
import FormattedDate from "../../../components/FormattedDate.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  // Merge case-variant tags, keep most-used casing as display name
  const normalizedMap = new Map<string, { displayName: string; nameCounts: Record<string, number> }>();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag) => {
      if (!tag || !tag.trim()) return;
      const key = tag.toLowerCase();
      const entry = normalizedMap.get(key) ?? { displayName: tag, nameCounts: {} };
      entry.nameCounts[tag] = (entry.nameCounts[tag] || 0) + 1;
      entry.displayName = Object.entries(entry.nameCounts).sort((a, b) => b[1] - a[1])[0][0];
      normalizedMap.set(key, entry);
    });
  });

  return Array.from(normalizedMap.values()).map(({ displayName }) => ({
    params: { tag: displayName },
    props: {
      tag: displayName,
      posts: posts
        .filter((post) => post.data.tags?.some((t) => t.toLowerCase() === displayName.toLowerCase()))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<IndexPage title={`标签: ${tag}`}>
  <About slot="left" />

  <section class="px-2" slot="right">
    <div class="mb-8">
      <a
        href="/blog/tags/"
        class="text-sm text-gray-400 dark:text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors"
      >
        &larr; 所有标签
      </a>
      <h1 class="text-3xl font-bold mt-2">{tag}</h1>
      <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">
        {posts.length} 篇文章
      </p>
    </div>

    <ul class="space-y-1">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex items-baseline justify-between gap-4 py-3 px-3 -mx-3 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
          >
            <h3 class="font-medium truncate group-hover:text-gray-900 dark:group-hover:text-white transition-colors">
              {post.data.title}
            </h3>
            <span class="text-sm text-gray-300 dark:text-gray-600 shrink-0 tabular-nums">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </a>
        ))
      }
    </ul>
  </section>
</IndexPage>
