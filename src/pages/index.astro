---
import { getCollection } from "astro:content";
import IndexPage from "../layouts/IndexPage.astro";
import About from "../components/About.astro";
import { Image } from "astro:assets";
import nmQR from "../assets/images/nmQR.png";
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((_, index) => index < 5);
---

<IndexPage title="首页">
  <About slot="left"></About>
  <div slot="right">
    <div class="rounded-md p-3 dark:border-gray-500">
      <h1 class="font-bold mb-3 title text-2xl dark:text-gray-200">Posts</h1>
      <ul>
        {
          posts.map((post) => (
            <li class="inline-block">
              <a
                class="my-2 mr-4 px-4 py-1 rounded-3xl
              text-lg dark:text-gray-300 text-gray-600 inline-block
              bg-slate-50 hover:bg-slate-100
              dark:bg-gray-500"
                href={`/posts/${post.slug}/`}
              >
                {post.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-md p-3 dark:border-gray-500">
      <h1 class="font-bold mb-3 title text-2xl dark:text-gray-200">Projects</h1>
      <div class="grid grid-cols-4 gap-2">
        <div
          class="col-span-4 p-3 bg-slate-50 hover:bg-slate-100 rounded-lg dark:bg-gray-300"
        >
          <div class="flex md:gap-6 h-32">
            <Image
              src={nmQR}
              width={130}
              height={120}
              alt={"nothin"}
              class="mix-blend-multiply"
            />
            <div class="flex flex-col justify-end p-3">
              <h3 class="font-bold text-xl dark:text-gray-600">NightMete</h3>
              <p class="md:text-base text-gray-900 dark:text-gray-600 text-sm">
                轻量级白噪音小程序。困意来袭，无需选择，一键开始入睡。辗转反侧，夜读陪你漫漫长夜。
              </p>
            </div>
          </div>
        </div>
        <div
          class="p-3 col-span-2 bg-slate-50 hover:bg-slate-100 rounded-lg dark:bg-gray-300"
        >
          <div class="flex flex-col justify-end p-3">
            <h3 class="font-bold text-xl dark:text-gray-600">Echo</h3>
            <p class="md:text-base text-gray-900 dark:text-gray-600 text-sm">
              书信风格长文本生成器。以书信的方式，投递文字的温度。
            </p>
          </div>
        </div>
        <a
          href="https://2l.haxck.com"
          target="_blank"
          rel="noopener noreferrer"
          class="col-span-2"
        >
          <div
            class="p-3 bg-slate-50 hover:bg-slate-100 rounded-lg dark:bg-gray-300"
          >
            <div class="flex flex-col justify-end p-3">
              <h3 class="font-bold text-xl dark:text-gray-600">2lover</h3>
              <p class="md:text-base text-gray-900 dark:text-gray-600 text-sm">
                土味情话，纪念日，猜丁壳，吃什么。
              </p>
            </div>
          </div></a
        >
      </div>
    </div>
  </div>
</IndexPage>
<style>
  @font-face {
    font-family: "得意黑";
    font-weight: 400;
    src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
    font-display: swap;
  }
  .title {
    font-family: "得意黑";
  }
</style>
