---
import { getCollection } from "astro:content";
import IndexPage from "../layouts/IndexPage.astro";
import About from "../components/About.astro";
import { Image } from "astro:assets";
import nmQR from "../assets/images/nmQR.png";
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter((_, index) => index < 5);
---

<IndexPage title="首页">
  <About slot="left" />
  <div slot="right">
    <div class="rounded-md dark:border-gray-500">
      <h1 class="font-bold mb-3 title text-2xl dark:text-gray-200">Posts</h1>
      <ul>
        {
          posts.map((post) => (
            <li class="max-sm:text-base max-sm:px-2 lg:text-lg my-2 px-4 py-1 hover:bg-gray-100 dark:hover:bg-gray-600 rounded-lg">
              <a
                class="
               dark:text-gray-300 text-gray-600 flex
              "
                href={`/posts/${post.slug}/`}
              >
                {post.data.title}
                <span class="border-t-2 border-dashed flex-1 m-3 max-sm:m-2.5" />
                <span>{post.data.pubDate.toLocaleDateString()}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-md  dark:border-gray-500">
      <h1 class="font-bold mb-3 title text-2xl dark:text-gray-200">Projects</h1>
      <div class="grid grid-cols-4 gap-2">
        <div class="col-span-4 p-3 bg-gray-100 rounded-lg dark:bg-gray-600">
          <div class="flex md:gap-6 h-32">
            <Image
              src={nmQR}
              width={130}
              height={120}
              alt={"nothin"}
              class="mix-blend-multiply"
            />
            <div class="flex flex-col justify-end p-3">
              <h3 class="font-bold text-xl dark:text-gray-300">NightMete</h3>
              <p class="md:text-base text-gray-900 dark:text-gray-400 text-sm">
                轻量级白噪音小程序。困意来袭，无需选择，一键开始入睡。辗转反侧，夜读陪你漫漫长夜。
              </p>
            </div>
          </div>
        </div>
        <div class="p-3 col-span-2 bg-gray-100 rounded-lg dark:bg-gray-600">
          <div class="flex flex-col justify-end p-3">
            <h3 class="font-bold text-xl dark:text-gray-300">Echo</h3>
            <p class="md:text-base text-gray-900 dark:text-gray-400 text-sm">
              书信风格长文本生成器。以书信的方式，投递文字的温度。
            </p>
          </div>
        </div>
        <a
          href="https://2l.haxck.com"
          target="_blank"
          rel="noopener noreferrer"
          class="col-span-2"
        >
          <div class="p-3 bg-gray-100 rounded-lg dark:bg-gray-600">
            <div class="flex flex-col justify-end p-3">
              <h3 class="font-bold text-xl dark:text-gray-300">2lover</h3>
              <p class="md:text-base text-gray-900 dark:text-gray-400 text-sm">
                土味情话，纪念日，猜丁壳，吃什么。
              </p>
            </div>
          </div></a
        >
      </div>
    </div>
  </div>
</IndexPage>
<style>
  @font-face {
    font-family: "得意黑";
    font-weight: 400;
    src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
    font-display: swap;
  }
  .title {
    font-family: "得意黑";
  }
</style>
