---
import IndexPage from "../layouts/IndexPage.astro";
import About from "../components/About.astro";
---

<IndexPage title="404">
  <About slot="left" />

  <section class="px-2" slot="right">
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <h1 class="text-8xl font-bold bg-gradient-to-r from-primary-500 to-secondary-500 bg-clip-text text-transparent mb-4">
        404
      </h1>
      <p class="text-gray-500 dark:text-gray-400 text-lg mb-8">
        页面不存在或已被移除
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium hover:opacity-90 transition-opacity"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        返回首页
      </a>
    </div>
  </section>
</IndexPage>
