---
import { getCollection } from "astro:content";
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";

const posts = await getCollection("blog");

const tagMap: Record<string, number> = {};
posts.forEach((post) => {
  post.data.tags?.forEach((tag) => {
    tagMap[tag] = (tagMap[tag] || 0) + 1;
  });
});
const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
---

<IndexPage title="标签">
  <About slot="left" />

  <section class="px-2" slot="right">
    <h1 class="text-3xl font-bold mb-2">标签</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">共 {tags.length} 个标签</p>

    <div class="flex flex-wrap gap-3">
      {
        tags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}/`}
            class="group inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white dark:bg-gray-700 shadow-md hover:shadow-lg transition-all duration-300 border border-gray-100 dark:border-gray-600"
          >
            <span class="text-gray-800 dark:text-gray-200 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors font-medium">
              {tag}
            </span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 font-medium">
              {count}
            </span>
          </a>
        ))
      }
    </div>
  </section>
</IndexPage>
