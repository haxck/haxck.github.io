---
import { getCollection } from "astro:content";
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const blogsByYear: Record<string, typeof blogs> = {};
const blogs = await getCollection("blog");

blogs
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((blog) => {
    const year = new Date(blog.data.pubDate).getFullYear().toString();
    if (!blogsByYear[year]) {
      blogsByYear[year] = [];
    }
    blogsByYear[year].push(blog);
  });
---

<IndexPage title="博客">
  <About slot="left" />

  <section class="px-2" slot="right">
    {
      Object.keys(blogsByYear)
        .sort((a, b) => Number(b) - Number(a))
        .map((year) => (
          <>
            <h2 class="py-4 text-2xl font-bold">
              {year}{" "}
              <span class="text-sm font-normal text-gray-400 dark:text-gray-500">
                ({blogsByYear[year].length} 篇)
              </span>
            </h2>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {blogsByYear[year].map((post) => (
                <a
                  href={`/posts/${post.id}/`}
                  class="group text-gray-900 dark:text-slate-100"
                >
                  <li class="overflow-hidden bg-white dark:bg-gray-700 shadow-md hover:shadow-lg rounded-xl transition-all duration-300 border border-gray-100 dark:border-gray-600">
                    {post.data.heroImage ? (
                      <div class="aspect-video overflow-hidden">
                        <img
                          src={post.data.heroImage}
                          alt=""
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      </div>
                    ) : (
                      <div class="aspect-video bg-gradient-to-br from-primary-100 to-secondary-100 dark:from-primary-900/40 dark:to-secondary-900/40 flex items-center justify-center">
                        <span class="text-3xl font-bold bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent select-none">
                          {post.data.title.charAt(0)}
                        </span>
                      </div>
                    )}
                    <div class="p-4">
                      <h3 class="font-medium line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                        {post.data.title}
                      </h3>
                      <p class="pt-2 text-sm text-gray-400 dark:text-slate-400">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </div>
                  </li>
                </a>
              ))}
            </ul>
          </>
        ))
    }
  </section>
</IndexPage>
