---
import { getCollection } from "astro:content";
import IndexPage from "../../layouts/IndexPage.astro";
import About from "../../components/About.astro";
import FormattedDate from "../../components/FormattedDate.astro";
const blogsByYear = {};

(await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.map((blog) => {
		let year = new Date(blog.data.pubDate).getFullYear();
		if (!blogsByYear[year]) {
			blogsByYear[year] = [];
		}
		blogsByYear[year].push(blog);
	});
---

<IndexPage>
	<About slot="left"></About>

	<section class="px-2" slot="right">
		<div>
			{
				Object.keys(blogsByYear).sort((a,b)=> -1).map((year) => (
					<>
						<h2 class="py-4 text-2xl font-bold dark:text-slate-200">{year} <span class="text-sm">({blogsByYear[year].length} 篇)</span></h2>
						<ul class="grid grid-cols-2 gap-4">
							{blogsByYear[year].map((post) => (
								<a
									class="text-gray-900  dark:text-slate-100"
									href={`/posts/${post.slug}/`}
								>
									<li class="p-4 dark:bg-slate-800 bg-white shadow-lg rounded-lg hover:shadow-xl hover:scale-105 transition ease-in-out ">
										{post.data.title}
										<p class="pt-2 shrink-0 text-gray-400 dark:text-slate-400 ">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</li>
								</a>
							))}
						</ul>
					</>
				))
			}
		</div>
	</section>
</IndexPage>
