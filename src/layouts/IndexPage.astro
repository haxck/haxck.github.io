---
import BasePage from "../layouts/BasePage.astro";
const {
  title, 
  sidebar = true,
  description,
  keywords,
} = Astro.props;
---

<BasePage title={title} description={description} keywords={keywords}>
  {sidebar ? (
    <div class="grid grid-cols-4 gap-6 animate-fade-in">
      <div class="col-span-4 lg:col-span-1">
        <slot name="left"></slot>
      </div>
      <div class="col-span-4 lg:col-span-3">
        <div class="p-6 sm:p-8 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200/60 dark:border-gray-800/60">
          <slot name="right"></slot>
        </div>
      </div>
    </div>
  ) : (
    <div class="animate-fade-in">
      <div class="p-6 sm:p-8 bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm rounded-2xl shadow-sm border border-gray-200/60 dark:border-gray-800/60">
        <slot name="right"></slot>
      </div>
    </div>
  )}
</BasePage>
