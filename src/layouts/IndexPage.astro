---
import BasePage from "../layouts/BasePage.astro";
const {title} = Astro.props;
---

<BasePage title={title}>
  <div class="grid grid-cols-4">
    <div
      class="p-3 col-span-4 lg:col-span-1"
    >
    <slot name="left"></slot>
    </div>
    <div class="mx-3 col-span-4 lg:col-span-3">
      <div class="max-sm:p-4 p-8 bg-white dark:bg-gray-800 shadow-xl">
        <slot name="right"></slot>
      </div>
    </div>
  </div>
</BasePage>

<style>
  @font-face {
    font-family: "得意黑";
    font-weight: 400;
    src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
    font-display: swap;
  }
  .title {
    font-family: "得意黑";
  }
</style>
