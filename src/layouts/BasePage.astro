---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const { title, description } = Astro.props;
---

<html lang="zh-cn">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-gradient-to-br from-primary-50 via-white to-secondary-50 dark:from-gray-800 dark:via-gray-900 dark:to-primary-900 min-h-screen">
    <Header />
    <main class="lg:max-w-screen-lg m-auto animate-fade-in">
        <slot />
    </main>

    <Footer />
  </body>
</html>