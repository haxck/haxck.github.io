---
import type { CollectionEntry } from "astro:content";
import BasePage from "./BasePage.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
const { frontmatter } = Astro.props;
---

<BasePage title={frontmatter.title}>
  <section class="listpage px-2 ">
    <slot />
  </section>
</BasePage>
<style is:global>
  .listpage .contains-task-list li {
    @apply flex items-center my-1;
  }
  .listpage .contains-task-list li:hover {
    @apply bg-slate-100;
  }
  .listpage .contains-task-list li input[type="checkbox"] {
    height: 1.25rem;
    width: 1.25rem;
    margin-right: 0.5rem;
  }
</style>
