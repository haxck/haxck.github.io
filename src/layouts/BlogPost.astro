---
import BasePage from "./BasePage.astro";
import FormattedDate from "../components/FormattedDate.astro";
import MpCard from "../components/MpCard.astro";
import TableOfContents from "../components/TOC.astro";
import Divider from "../components/Divider.astro";

const { title, description, pubDate, updatedDate, heroImage, tags, toc, ai } =
	Astro.props;
---
<BasePage title={title}>
	{ai && ai.map((items) => <span class="mr-1 p-1">{items.ai}</span>)}
	<div class="grid md:grid-cols-12 grid-cols-9">
		<article class="col-span-9 py-8 px-4 m-2 bg-white dark:bg-gray-800 shadow-xl rounded-xl">
			{heroImage && <img width={720} height={360} src={heroImage} alt="" />}
			<p class="text-slate-600 dark:text-slate-300 title">
				{tags && tags.map((items) => <span class="mr-1 p-1">#{items}</span>)}
			</p>
			<h1 class="text-5xl font-bold dark:text-slate-300 title">
				{title}
			</h1>
			<div class="text-slate-500 dark:text-slate-400 my-2 text-sm title">
				<p>
					文章发表于 <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="ml-2">
								最后更新于
								<FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
			</div>
			<div
				class="mt-8 min-w-full text-lg leading-8 tracking-wide heti"
			>
				<slot />
			</div>
			<Divider />
			<div>
				<div class="tracking-wide text-base text-gray-600">
					本站内容可随意转载，不需要注明作者，就说是你写的！
				</div>
			</div>
		</article>
		<aside class="col-span-3 p-4 relative max-sm:hidden">
			<div class="sticky top-1">
				<TableOfContents {...Astro.props} />
				<MpCard />
			</div>
		</aside>
	</div>
</BasePage>

<style>
	@font-face {
		font-family: "得意黑";
		font-weight: 400;
		src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
		font-display: swap;
	}
	.title {
		font-family: "得意黑";
	}
</style>