---

import FormattedDate from "../components/FormattedDate.astro";
import About from "../components/About.astro";
import IndexPage from "./IndexPage.astro";
import MpCard from "../components/MpCard.astro";
import TableOfContents from "../components/TOC.astro";
import Divider from "../components/Divider.astro";

const { title, description, pubDate, updatedDate, heroImage, tags, toc, ai } =
	Astro.props;
---

<IndexPage title={title}>
	<About slot="left">
		<aside class="relative max-lg:hidden text-right min-h-[100vh]">
			<div class="sticky top-6">
				<TableOfContents {...Astro.props} />
				<MpCard></MpCard>
			</div>
		</aside>
	</About>
	<div slot="right">
		<article class="prose min-w-full">
			{heroImage && <img width={720} height={360} src={heroImage} alt="" />}

			<h1 class="mb-0 dark:text-slate-300 title">
				{title}
			</h1>
			<div class="text-slate-500 dark:text-slate-400 text-sm title">
				<p class="text-slate-600 dark:text-slate-300 title">
					{tags && tags.map((items) => <span class="mr-1 p-1">#{items}</span>)}

				<span>
					· &nbsp; 文章发表于 <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="ml-2">
								最后更新于
								<FormattedDate date={updatedDate} />
							</span>
						)
					}
				</span>
			</p>
			</div>
			<div class="mt-8 min-w-full text-lg leading-8 tracking-wide heti">
				<slot />
			</div>
			<Divider />
			<div>
				<div class="tracking-wide text-base text-gray-600">
					本站内容可随意转载，不需要注明作者，就说是你写的！
				</div>
			</div>
		</article>
	</div>
</IndexPage>

<style>
	@font-face {
		font-family: "得意黑";
		font-weight: 400;
		src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
		font-display: swap;
	}
	.title {
		font-family: "得意黑";
	}
</style>
