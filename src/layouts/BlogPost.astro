---
import { getCollection } from "astro:content";
import BasePage from "./BasePage.astro";
import FormattedDate from "../components/FormattedDate.astro";
import TableOfContents from "../components/TOC.astro";
import Divider from "../components/Divider.astro";
import JsonLd from "../components/JsonLd.astro";
import { Icon } from 'astro-icon/components'
import AI from "../components/AI.astro";

const { title, description, pubDate, updatedDate, heroImage, tags, toc, ai } =
	Astro.props;

const allPosts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const articleUrl = Astro.url.toString();
const publishedISO = pubDate instanceof Date ? pubDate.toISOString() : new Date(pubDate).toISOString();
const modifiedISO = updatedDate instanceof Date ? updatedDate.toISOString() : updatedDate ? new Date(updatedDate).toISOString() : undefined;
---

<BasePage 
	title={title} 
	description={description}
	type="article"
	image={heroImage}
	publishedTime={publishedISO}
	modifiedTime={modifiedISO}
	tags={tags}
>
	<JsonLd 
		type="article"
		title={title}
		description={description}
		url={articleUrl}
		image={heroImage}
		publishedTime={publishedISO}
		modifiedTime={modifiedISO}
		tags={tags}
	/>
	<div class="max-w-screen-lg mx-auto px-4">
		{toc.length > 1 ? (
			<div class="grid grid-cols-1 xl:grid-cols-[1fr_14rem] gap-8">
				<article class="prose dark:prose-invert max-w-none py-4" itemscope itemtype="https://schema.org/Article">
					{heroImage && (
						<div class="rounded-2xl overflow-hidden mb-6 -mt-2 shadow-md">
							<img width={720} height={360} src={heroImage} alt={title} class="w-full" itemprop="image" />
						</div>
					)}

					<h1 class="mb-0 title" itemprop="headline">
						{title}
					</h1>

					<div class="not-prose mt-3 mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
						{tags && tags.length > 0 && tags.map((tag: string) => (
							<a
								href={`/blog/tags/${tag}/`}
								class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 hover:bg-primary-100 dark:hover:bg-primary-900/50 transition-colors"
								rel="tag"
							>
								{tag}
							</a>
						))}

						{tags && tags.length > 0 && <span class="w-px h-3.5 bg-gray-200 dark:bg-gray-700" />}

						<span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
							<Icon name="mdi:calendar-outline" class="w-3.5 h-3.5" />
							<time datetime={publishedISO} itemprop="datePublished">
								<FormattedDate date={pubDate} />
							</time>
						</span>

						{updatedDate && (
							<span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
								<Icon name="mdi:update" class="w-3.5 h-3.5" />
								<time datetime={modifiedISO} itemprop="dateModified">
									<FormattedDate date={updatedDate} />
								</time>
							</span>
						)}

						<span id="busuanzi_container_page_pv" style="display:none">					
							<div class="flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
								<Icon name="mdi:eye-outline" class="w-3.5 h-3.5" />
								<span id="busuanzi_value_page_pv"></span>
							</div>
						</span>
					</div>

					{ai && <AI ai={ai} />}
					<div class="mt-8 min-w-full leading-7" itemprop="articleBody">
						<slot />
					</div>

					<!-- Author & License Card -->
					<div class="mt-10 not-prose">
						<div class="rounded-2xl bg-gradient-to-br from-gray-50 to-gray-100/50 dark:from-gray-800/50 dark:to-gray-900/50 border border-gray-200/60 dark:border-gray-700/40 overflow-hidden">
							<div class="p-6">
								<div class="flex items-start gap-4">
									<img src="/images/icon180.png" alt="Haxck" class="w-14 h-14 rounded-full ring-2 ring-white dark:ring-gray-700 shadow-sm shrink-0" />
									<div class="flex-1 min-w-0">
										<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Haxck</h3>
										<p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Creator & Developer · 做产品 / 写代码 / 喜设计</p>
									</div>
								</div>

								<div class="mt-5 pt-5 border-t border-gray-200/60 dark:border-gray-700/40 space-y-3">
								<div class="grid grid-cols-[auto_1fr] items-center gap-x-2.5 gap-y-0.5">
									<div class="row-span-2 self-center">
										<Icon name="mdi:link-variant" class="w-4 h-4 text-gray-400 dark:text-gray-500" />
									</div>
									<span class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">文章地址</span>
									<p class="text-sm text-gray-600 dark:text-gray-300 truncate">{articleUrl}</p>
								</div>
								<div class="grid grid-cols-[auto_1fr] items-center gap-x-2.5 gap-y-0.5">
									<div class="row-span-2 self-center">
										<Icon name="mdi:creative-commons" class="w-4 h-4 text-gray-400 dark:text-gray-500" />
									</div>
									<span class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">许可协议</span>
									<p class="text-sm text-gray-600 dark:text-gray-300">
										本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">CC BY-NC-SA 4.0</a> 许可协议，转载请联系作者并注明出处
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>


					<div class="mt-10 pt-8 border-t border-gray-200/60 dark:border-gray-700/40 not-prose">
						<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">最近文章</h2>
						<ul class="flex flex-col gap-1.5">
							{allPosts.map((post) => (
								<li>
									<a
										href={`/blog/${post.id}/`}
										class="group flex items-center justify-between gap-3 py-2 px-3 rounded-lg hover:bg-gray-100/60 dark:hover:bg-gray-800/40 transition-colors"
									>
										<span class="text-sm text-gray-700 dark:text-gray-300 line-clamp-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
											{post.data.title}
										</span>
										<time class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap tabular-nums shrink-0">
											<FormattedDate date={post.data.pubDate} />
										</time>
									</a>
								</li>
							))}
						</ul>
					</div>
				</article>

				<!-- TOC Sidebar -->
				<aside class="hidden xl:block">
					<div class="sticky top-24">
						<h3 class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-3">
							目录
						</h3>
						<TableOfContents toc={toc} />
					</div>
				</aside>
			</div>
		) : (
			<article class="prose dark:prose-invert max-w-none py-4" itemscope itemtype="https://schema.org/Article">
				{heroImage && (
					<div class="rounded-2xl overflow-hidden mb-6 -mt-2 shadow-md">
						<img width={720} height={360} src={heroImage} alt={title} class="w-full" itemprop="image" />
					</div>
				)}

				<h1 class="mb-0 title" itemprop="headline">
					{title}
				</h1>

				<div class="not-prose mt-3 mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
					{tags && tags.length > 0 && tags.map((tag: string) => (
						<a
							href={`/blog/tags/${tag}/`}
							class="inline-flex items-center px-2.5 py-1 text-xs font-medium rounded-full bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 hover:bg-primary-100 dark:hover:bg-primary-900/50 transition-colors"
							rel="tag"
						>
							{tag}
						</a>
					))}

					{tags && tags.length > 0 && <span class="w-px h-3.5 bg-gray-200 dark:bg-gray-700" />}

					<span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
						<Icon name="mdi:calendar-outline" class="w-3.5 h-3.5" />
						<time datetime={publishedISO} itemprop="datePublished">
							<FormattedDate date={pubDate} />
						</time>
					</span>

					{updatedDate && (
						<span class="inline-flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
							<Icon name="mdi:update" class="w-3.5 h-3.5" />
							<time datetime={modifiedISO} itemprop="dateModified">
								<FormattedDate date={updatedDate} />
							</time>
						</span>
					)}

					<span id="busuanzi_container_page_pv" style="display:none">					
						<div class="flex items-center gap-1 text-xs text-gray-400 dark:text-gray-500">
							<Icon name="mdi:eye-outline" class="w-3.5 h-3.5" />
							<span id="busuanzi_value_page_pv"></span>
						</div>
					</span>
				</div>

				{ai && <AI ai={ai} />}
				<div class="mt-8 min-w-full leading-7" itemprop="articleBody">
					<slot />
				</div>

				<!-- Author & License Card -->
				<div class="mt-10 not-prose">
					<div class="rounded-2xl bg-gradient-to-br from-gray-50 to-gray-100/50 dark:from-gray-800/50 dark:to-gray-900/50 border border-gray-200/60 dark:border-gray-700/40 overflow-hidden">
						<div class="p-6">
							<div class="flex items-start gap-4">
								<img src="/images/icon180.png" alt="Haxck" class="w-14 h-14 rounded-full ring-2 ring-white dark:ring-gray-700 shadow-sm shrink-0" />
								<div class="flex-1 min-w-0">
									<h3 class="text-base font-semibold text-gray-900 dark:text-gray-100">Haxck</h3>
									<p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">Creator & Developer · 做产品 / 写代码 / 喜设计</p>
								</div>
							</div>

							<div class="mt-5 pt-5 border-t border-gray-200/60 dark:border-gray-700/40 space-y-3">
							<div class="grid grid-cols-[auto_1fr] items-center gap-x-2.5 gap-y-0.5">
								<div class="row-span-2 self-center">
									<Icon name="mdi:link-variant" class="w-4 h-4 text-gray-400 dark:text-gray-500" />
								</div>
								<span class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">文章地址</span>
								<p class="text-sm text-gray-600 dark:text-gray-300 truncate">{articleUrl}</p>
							</div>
							<div class="grid grid-cols-[auto_1fr] items-center gap-x-2.5 gap-y-0.5">
								<div class="row-span-2 self-center">
									<Icon name="mdi:creative-commons" class="w-4 h-4 text-gray-400 dark:text-gray-500" />
								</div>
								<span class="text-xs font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">许可协议</span>
								<p class="text-sm text-gray-600 dark:text-gray-300">
									本文采用 <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh" target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline">CC BY-NC-SA 4.0</a> 许可协议，转载请联系作者并注明出处
								</p>
							</div>
						</div>
					</div>
				</div>
			</div>

				<div class="mt-10 pt-8 border-t border-gray-200/60 dark:border-gray-700/40 not-prose">
					<h2 class="text-lg font-semibold text-gray-800 dark:text-gray-100 mb-4">最近文章</h2>
					<ul class="flex flex-col gap-1.5">
						{allPosts.map((post) => (
							<li>
								<a
									href={`/blog/${post.id}/`}
									class="group flex items-center justify-between gap-3 py-2 px-3 rounded-lg hover:bg-gray-100/60 dark:hover:bg-gray-800/40 transition-colors"
								>
									<span class="text-sm text-gray-700 dark:text-gray-300 line-clamp-1 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
										{post.data.title}
									</span>
									<time class="text-xs text-gray-400 dark:text-gray-500 whitespace-nowrap tabular-nums shrink-0">
										<FormattedDate date={post.data.pubDate} />
									</time>
								</a>
							</li>
						))}
					</ul>
				</div>
			</article>
		)}
	</div>

	<!-- Image modal -->
	<div id="imageModal" class="fixed inset-0 z-50 hidden bg-black/90 flex items-center justify-center p-4" style="backdrop-filter:blur(5px)">
		<button id="closeModal" class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl leading-none z-10">&times;</button>
		<div class="relative max-w-full max-h-full flex items-center justify-center">
			<img id="modalImage" src="" alt="" class="max-w-full max-h-[85vh] object-contain rounded-lg" />
		</div>
	</div>

	<script>
		function setupImageModal() {
			const modal = document.getElementById("imageModal");
			const modalImg = document.getElementById("modalImage");
			const closeBtn = document.getElementById("closeModal");
			if (!modal || !modalImg) return;

			const prose = document.querySelector(".prose");
			if (!prose) return;

			prose.addEventListener("click", (e) => {
				const target = e.target as HTMLElement;
				if (target.tagName === "IMG" && (target as HTMLImageElement).naturalWidth > 100) {
					modalImg.src = (target as HTMLImageElement).src;
					modalImg.alt = (target as HTMLImageElement).alt;
					modal.classList.remove("hidden");
					document.body.style.overflow = "hidden";
				}
			});

			function closeModal() {
				modal.classList.add("hidden");
				document.body.style.overflow = "";
			}

			closeBtn?.addEventListener("click", closeModal);
			modal.addEventListener("click", (e) => {
				if (e.target === modal) closeModal();
			});
			document.addEventListener("keydown", (e) => {
				if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
			});
		}

		setupImageModal();
		document.addEventListener("astro:page-load", setupImageModal);
	</script>
</BasePage>
<script>
	function loadBusuanzi() {
		const existing = document.querySelector('script[src*="busuanzi"]');
		if (existing) {
			existing.remove();
		}
		const s = document.createElement("script");
		s.src = "https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js";
		s.async = true;
		document.head.appendChild(s);
	}

	loadBusuanzi();
	document.addEventListener("astro:page-load", loadBusuanzi);
</script>
<style>
	.title {
		font-family: "得意黑";
	}
</style>
