---

import FormattedDate from "../components/FormattedDate.astro";
import About from "../components/About.astro";
import IndexPage from "./IndexPage.astro";
import MpCard from "../components/MpCard.astro";
import TableOfContents from "../components/TOC.astro";
import Divider from "../components/Divider.astro";
import { Icon } from 'astro-icon/components'

const { title, description, pubDate, updatedDate, heroImage, tags, toc, ai } =
	Astro.props;
---

<IndexPage title={title}>
	<About slot="left">
		<aside class="max-lg:hidden text-right">
			{toc.length > 1 && (
				<div>
					<TableOfContents toc={toc} />
					<MpCard></MpCard>
				</div>
			)}
		</aside>
	</About>
	<div slot="right">
		<article class="prose min-w-full">
			{heroImage && <img width={720} height={360} src={heroImage} alt="" />}

			<h1 class="mb-0 title">
				{title}
			</h1>
			<div class="text-slate-500 text-sm title">
				<p class="text-slate-600 title">

					<span id="busuanzi_container_page_pv" style="display: none;">
						<span id="busuanzi_value_page_pv"></span>
						<Icon name="mdi:account-view" class:list={"inline-block"} />
						
						 &nbsp;
					</span>

					{tags && tags.map((items) => <span class="mr-1 p-1">{items}</span>)}

				<span>
					· &nbsp; <Icon name="mdi:clipboard-text-date" class:list={"inline-block"} /> <FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="ml-2">
								最后更新于
								<FormattedDate date={updatedDate} />
							</span>
						)
					}
				</span>
			</p>
			</div>
			<div class="mt-8 min-w-full leading-7">
				<slot />
			</div>
			<Divider />
		</article>
	</div>
</IndexPage>
<script is:inline defer src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
<style>
	@font-face {
		font-family: "得意黑";
		font-weight: 400;
		src: url("/SmileySans-Oblique.otf.woff2") format("woff2");
		font-display: swap;
	}
	.title {
		font-family: "得意黑";
	}
</style>
